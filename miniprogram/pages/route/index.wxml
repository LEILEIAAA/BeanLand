<view class="container">
  <view class="hero">
    <view class="eyebrow">第一次来请看这里</view>
    <view class="title">新青年广场 A 座顶楼</view>
    <view class="subtitle">{{store.routeTip}}</view>
  </view>

  <view class="section">
    <view class="card map-card">
      <map
        class="route-map"
        latitude="{{store.latitude}}"
        longitude="{{store.longitude}}"
        scale="{{store.scale}}"
        markers="{{[{ id: 1, latitude: store.latitude, longitude: store.longitude, title: store.markerName, width: 32, height: 32 }]}}"
        show-compass="true"
        enable-3D="true"
      />
      <view class="card-title">门店位置</view>
      <view class="card-meta">{{store.address}}</view>
      <view class="button-row">
        <view class="btn btn-primary" bindtap="openMap">打开地图导航</view>
        <view class="btn btn-secondary" bindtap="copyAddress">复制地址</view>
      </view>
      <view class="button-row">
        <view class="btn btn-secondary" bindtap="callStore">拨打电话</view>
      </view>
    </view>
    <view class="card">
      <view class="card-title">到店指引</view>
      <view class="card-meta">1. 到新青年广场后，走 A 座入口。</view>
      <view class="card-meta">2. 乘电梯到顶楼，找 A幢 2617（Bean Land）。</view>
      <view class="card-meta">3. 找不到别兜圈——点「拨打电话」，我们接你。</view>
    </view>
  </view>
</view>
