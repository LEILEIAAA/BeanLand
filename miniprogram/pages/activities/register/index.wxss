@import "../../packages/index.wxss";
@import "../../member/_sub.wxss";

.reg-page {
  padding-bottom: 56rpx;
}

.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.buy-section-label {
  margin: 8rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #57534e;
}

.reg-hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.06);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 48rpx rgba(24, 24, 27, 0.06);
}

.reg-hero .hero-bands {
  opacity: 0.9;
}

.reg-hero .band {
  height: 360rpx;
}

.reg-hero-copy {
  position: relative;
  z-index: 2;
}

.reg-kicker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reg-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.reg-status {
  font-size: 22rpx;
  font-weight: 700;
  color: #71717a;
}

.reg-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  line-height: 1.12;
  color: #18181b;
}

.reg-hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #71717a;
}

.reg-hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.reg-seat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #18181b;
  line-height: 1;
}

.reg-seat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #a1a1aa;
}

.reg-price-orb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 24, 27, 0.12);
}

.reg-price {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.reg-highlights {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.reg-hl {
  flex: 1;
  min-width: 0;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.06);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(24, 24, 27, 0.04);
}

.reg-hl-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.reg-hl-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #18181b;
}

.reg-panel {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.06);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 32rpx rgba(24, 24, 27, 0.04);
}

.reg-panel-head {
  margin-bottom: 8rpx;
}

.reg-panel-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.reg-panel-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #18181b;
}

.reg-block {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(24, 24, 27, 0.06);
}

.reg-block-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #a1a1aa;
}

.reg-block-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #3f3f46;
}

.reg-block.is-lead .reg-block-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #18181b;
  line-height: 1.55;
}

.reg-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.reg-chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #3f3f46;
  background: #f4f4f5;
}

.reg-notice {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border-left: 8rpx solid #ffb80a;
  background: rgba(255, 184, 10, 0.12);
}

.reg-notice-label {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #a16207;
}

.reg-notice-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.55;
  color: #713f12;
}
