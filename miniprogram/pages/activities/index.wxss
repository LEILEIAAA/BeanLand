.act-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -8rpx 8rpx;
  padding: 56rpx 36rpx 48rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.06);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 48rpx rgba(24, 24, 27, 0.06);
}

.act-hero .hero-bands {
  opacity: 0.95;
}

.act-hero .band {
  height: 420rpx;
}

.act-hero-copy {
  position: relative;
  z-index: 2;
}

.act-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.act-title {
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.05;
  color: #18181b;
}

.act-sub {
  margin-top: 16rpx;
  max-width: 560rpx;
  color: #52525b;
  font-size: 26rpx;
  line-height: 1.55;
  font-weight: 500;
}

.act-stats {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 28rpx;
}

.act-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  color: #ff3d02;
  line-height: 1;
}

.act-stat-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #71717a;
}

.act-week {
  margin: 28rpx 0 8rpx;
  padding: 28rpx 24rpx 8rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.06);
  background: rgba(255, 255, 255, 0.88);
}

.act-week-head {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.act-week-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.act-week-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #18181b;
}

.act-week-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #a1a1aa;
}

.act-week-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-top: 1rpx solid rgba(24, 24, 27, 0.06);
}

.act-week-row.is-rest {
  opacity: 0.72;
}

.act-week-day {
  flex-shrink: 0;
  min-width: 88rpx;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  color: #ff3d02;
  line-height: 1.4;
}

.act-week-body {
  flex: 1;
  min-width: 0;
}

.act-week-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #18181b;
  line-height: 1.3;
}

.act-week-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #71717a;
  line-height: 1.45;
}

.act-week-status {
  flex-shrink: 0;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #52525b;
}

.act-filters {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin: 36rpx 0 8rpx;
  padding-bottom: 8rpx;
}

.act-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #52525b;
  background: #f4f4f5;
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.act-chip.is-on {
  color: #fff;
  background: #18181b;
  transform: translateY(-2rpx);
}

.act-section-head {
  margin: 36rpx 0 28rpx;
}

.act-section-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.act-section-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #18181b;
  line-height: 1.1;
}

.poster-stack {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 8rpx 0 12rpx;
}

.poster-card {
  width: 92%;
  animation: actRise 0.45s ease both;
}

.poster-card.shift-left {
  align-self: flex-start;
}

.poster-card.shift-right {
  align-self: flex-end;
}

.act-poster:nth-child(2) {
  animation-delay: 0.06s;
}

.act-poster:nth-child(3) {
  animation-delay: 0.12s;
}

.act-poster:nth-child(4) {
  animation-delay: 0.18s;
}

.act-poster:nth-child(5) {
  animation-delay: 0.24s;
}

.act-poster:nth-child(6) {
  animation-delay: 0.3s;
}

.act-poster:nth-child(7) {
  animation-delay: 0.36s;
}

.poster-media {
  position: relative;
  height: 440rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #f4f4f5;
  box-shadow: 0 18rpx 48rpx rgba(24, 24, 27, 0.12);
}

.poster-cover {
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.04);
}

.poster-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    160deg,
    rgba(24, 24, 27, 0.05) 0%,
    rgba(24, 24, 27, 0.22) 42%,
    rgba(24, 24, 27, 0.74) 100%
  );
  pointer-events: none;
}

.poster-tag {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 2;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.poster-status {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 2;
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.poster-title {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 36rpx;
  z-index: 2;
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -1rpx;
  text-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
}

.poster-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: -36rpx;
  padding: 0 16rpx 0 28rpx;
  position: relative;
  z-index: 3;
}

.poster-meta-col {
  flex: 1;
  min-width: 0;
  padding-top: 48rpx;
}

.poster-meta {
  font-size: 22rpx;
  font-weight: 700;
  color: #71717a;
}

.poster-blurb {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #3f3f46;
  line-height: 1.4;
}

.poster-orb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(24, 24, 27, 0.18);
  flex-shrink: 0;
}

.act-orb {
  animation: actPulse 2.4s ease-in-out infinite;
}

.poster-orb-price {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.act-empty {
  margin-top: 48rpx;
  padding: 56rpx 36rpx;
  border-radius: 32rpx;
  background: #f4f4f5;
  text-align: center;
}

.act-empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #18181b;
}

.act-empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #71717a;
  line-height: 1.5;
}

.act-empty-btn {
  margin-top: 28rpx;
}

@keyframes actRise {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes actPulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

@media (prefers-reduced-motion: reduce) {
  .poster-card,
  .act-orb,
  .act-chip {
    animation: none;
    transition: none;
  }
}
