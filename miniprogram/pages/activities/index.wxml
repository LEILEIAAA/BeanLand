<view class="container activities-page tab-page">
  <view class="act-hero">
    <view class="hero-bands" aria-hidden="true">
      <view class="band band-yellow"></view>
      <view class="band band-orange"></view>
      <view class="band band-pink"></view>
      <view class="band band-blue"></view>
      <view class="band band-green"></view>
    </view>
    <view class="act-hero-copy">
      <view class="act-kicker" wx:if="{{hero.subtitle}}">{{hero.subtitle}}</view>
      <view class="act-title">{{hero.title}}</view>
      <view class="act-sub" wx:if="{{hero.content}}">{{hero.content}}</view>
      <view class="act-stats">
        <text class="act-stat-num">{{featuredCount}}</text>
        <text class="act-stat-label">场招募中</text>
      </view>
    </view>
  </view>

  <view class="act-week" wx:if="{{openingWeek.length}}">
    <view class="act-week-head">
      <view class="act-week-kicker">Schedule</view>
      <view class="act-week-title">{{scheduleTitle}}</view>
      <view class="act-week-hint">具体日期若有调整，以本页为准</view>
    </view>
    <block wx:for="{{openingWeek}}" wx:key="activityId">
      <view class="act-week-row {{item.kind === 'rest' ? 'is-rest' : ''}}">
        <view class="act-week-day" wx:if="{{item.day}}">D{{item.day}}</view>
        <view class="act-week-body">
          <view class="act-week-name">{{item.title}}</view>
          <view class="act-week-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
        <view class="act-week-status" wx:if="{{item.status}}">{{item.status}}</view>
      </view>
    </block>
  </view>

  <scroll-view class="act-filters" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <block wx:for="{{filters}}" wx:key="id">
      <view
        class="act-chip {{activeFilter === item.id ? 'is-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onFilterTap"
      >{{item.label}}</view>
    </block>
  </scroll-view>

  <view class="act-section-head">
    <view class="act-section-kicker">Drops</view>
    <view class="act-section-title">活动海报墙</view>
  </view>

  <view class="poster-stack" wx:if="{{activities.length}}">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="poster-card {{item.shift}} act-poster" data-id="{{item.id}}" bindtap="join">
        <view class="poster-media">
          <image
            class="poster-cover"
            src="{{item.cover}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onActivityCoverError"
          />
          <view class="poster-scrim"></view>
          <view class="poster-tag" style="background: {{item.accent}}; color: {{item.orbInk}};">{{item.enLabel}}</view>
          <view class="poster-status">{{item.statusLabel}}</view>
          <view class="poster-title">{{item.name}}</view>
        </view>
        <view class="poster-foot">
          <view class="poster-meta-col">
            <view class="poster-meta">#{{item.dropNo}} · {{item.seatLabel}} 已报</view>
            <view class="poster-blurb">{{item.blurb}}</view>
          </view>
          <view class="poster-orb act-orb" style="background: {{item.accent}};">
            <text class="poster-orb-price" style="color: {{item.orbInk}};">¥{{item.priceText}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="act-empty" wx:else>
    <view class="act-empty-title">这一类暂时没局</view>
    <view class="act-empty-sub">换个筛选看看，或者直接咨询店主开一场。</view>
    <view class="btn btn-primary act-empty-btn" bindtap="join">换个筛选</view>
  </view>
</view>
