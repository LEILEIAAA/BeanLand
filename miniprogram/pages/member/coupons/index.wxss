@import "../_sub.wxss";

.coupon-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.coupon-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-tab.active {
  background: #111827;
  color: #fff;
}

.coupon-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.coupon-dimmed {
  opacity: 0.55;
}

.empty-tip {
  margin-top: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
