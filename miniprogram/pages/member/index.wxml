<view class="container member-page tab-page">
  <view class="asset-card">
    <view class="asset-orb orb-a"></view>
    <view class="asset-orb orb-b"></view>
    <view class="asset-orb orb-c"></view>
    <view class="asset-body">
      <view class="asset-main">
        <view class="asset-left">
          <view class="asset-kicker">
            <image class="kicker-icon" src="/assets/icons/bean.png" mode="aspectFit" />
            <text>我的豆子</text>
            <text class="tier-badge">{{tierLabel}}</text>
          </view>
          <view class="asset-balance-row">
            <view class="asset-balance">{{member.totalBalanceText}}</view>
            <image class="unit-icon" src="/assets/icons/bean.png" mode="aspectFit" />
          </view>
        </view>

        <view class="asset-profile" bindtap="goRegister">
          <view class="avatar-wrap">
            <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
          </view>
          <view class="nickname-display">{{nickName || '点击完善资料'}}</view>
        </view>
      </view>

      <view class="asset-actions">
        <view class="btn btn-primary" bindtap="goRecharge">立即充值</view>
        <view class="btn btn-secondary" bindtap="goAppointment">去预约</view>
      </view>
    </view>
  </view>

  <view class="stamp-card" bindtap="goStamps">
    <view class="stamp-head">
      <view>
        <view class="stamp-title">我的集章</view>
        <view class="stamp-sub">到店体验、带新朋友、主题局都能攒</view>
      </view>
      <view class="stamp-count">
        <text class="stamp-num">{{member.stampCount}}</text>
        <text class="stamp-den">/{{member.stampTarget}}</text>
      </view>
    </view>
    <view class="stamp-track">
      <block wx:for="{{stampDots}}" wx:key="index">
        <view class="stamp-dot {{item.filled ? 'filled' : ''}}">
          <image wx:if="{{item.filled}}" class="stamp-dot-icon" src="/assets/icons/bean.png" mode="aspectFit" />
        </view>
      </block>
    </view>
    <view class="stamp-foot">
      <text>{{stampHint}}</text>
      <text class="stamp-arrow">查看</text>
    </view>
  </view>

  <!-- 临时隐藏：改 showWorksCard 为 true 可恢复 -->
  <view wx:if="{{showWorksCard}}" class="works-card" bindtap="goWorks">
    <view class="works-card-head">
      <view>
        <view class="works-card-title">我的拼豆</view>
        <view class="works-card-sub">{{worksHint}}</view>
      </view>
      <view class="works-card-count">{{workCount}}</view>
    </view>
    <view wx:if="{{!worksEmpty}}" class="works-thumbs">
      <image
        wx:for="{{previewThumbs}}"
        wx:key="id"
        class="works-thumb"
        src="{{item.imageFileID}}"
        mode="aspectFill"
      />
    </view>
    <view class="works-card-foot">
      <text>{{worksEmpty ? '还没有作品，去拍一张' : '查看全部'}}</text>
      <text class="works-card-arrow">查看</text>
    </view>
  </view>

  <view class="action-list">
    <block wx:for="{{actions}}" wx:key="key">
      <view class="action-row" data-key="{{item.key}}" bindtap="onShortcut">
        <view class="action-left">
          <view class="action-icon-wrap">
            <image class="action-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <view>
            <view class="action-label">{{item.label}}</view>
            <view class="action-desc">{{item.desc}}</view>
          </view>
        </view>
        <view class="action-right">
          <text wx:if="{{item.badge}}" class="action-badge">{{item.badge}}</text>
          <text class="action-chevron">›</text>
        </view>
      </view>
    </block>
  </view>
</view>
