    0 20rpx 48rpx rgba(180, 83, 9, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.asset-card.tier-vip .asset-glow.glow-a {
  background: radial-gradient(circle, rgba(251, 191, 36, 0.32), transparent 70%);
}

.asset-card.tier-vip .asset-glow.glow-b {
  background: radial-gradient(circle, rgba(245, 158, 11, 0.16), transparent 72%);
}

.asset-card.tier-vip .asset-kicker {
  background: rgba(251, 191, 36, 0.18);
  border-color: rgba(217, 119, 6, 0.16);
  color: #92400e;
}

.asset-card.tier-vip .btn-recharge {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #78350f;
}

.asset-card.tier-svip {
  border-color: rgba(194, 65, 12, 0.22);
  background:
    linear-gradient(155deg, #fff7ed 0%, #ffedd5 42%, #fef3c7 100%);
  box-shadow:
    0 22rpx 52rpx rgba(154, 52, 18, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.asset-card.tier-svip .asset-glow.glow-a {
  background: radial-gradient(circle, rgba(249, 115, 22, 0.34), transparent 70%);
}

.asset-card.tier-svip .asset-glow.glow-b {
  background: radial-gradient(circle, rgba(251, 191, 36, 0.22), transparent 72%);
}

.asset-card.tier-svip .asset-rim {
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85),
    inset 0 0 0 1rpx rgba(194, 65, 12, 0.08),
    inset 0 -1rpx 0 rgba(154, 52, 18, 0.06);
}

.asset-card.tier-svip .asset-kicker {
  background: rgba(249, 115, 22, 0.16);
  border-color: rgba(194, 65, 12, 0.2);
  color: #9a3412;
}

.asset-card.tier-svip .btn-recharge {
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #7c2d12;
}

.asset-card.tier-svip .avatar-wrap {
  border-color: rgba(194, 65, 12, 0.18);
