  height: 56rpx;
  border-radius: 18rpx;
  border: 1rpx dashed rgba(17, 24, 39, 0.14);
  background: rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stamp-dot.filled {
  border-style: solid;
  border-color: rgba(17, 24, 39, 0.08);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 14rpx rgba(180, 83, 9, 0.1);
