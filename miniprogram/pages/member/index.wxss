}

.tier-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 25, 23, 0.05);
  border: 1rpx solid rgba(28, 25, 23, 0.06);
