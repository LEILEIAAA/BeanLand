.action-list {
  border-radius: 28rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.06);
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(28, 25, 23, 0.04);
  overflow: hidden;
}

.board-label {
  padding: 22rpx 26rpx 8rpx;
  color: #a8a29e;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 26rpx;
}

.action-row + .action-row {
  border-top: 1rpx solid rgba(28, 25, 23, 0.05);
}

.action-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.action-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #fafaf9;
  border: 1rpx solid rgba(28, 25, 23, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 34rpx;
  height: 34rpx;
}

.action-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}

.action-desc {
  margin-top: 4rpx;
  color: #a8a29e;
  font-size: 22rpx;
}

.action-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.action-badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
  color: #57534e;
  font-size: 20rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.action-badge.with-icon {
  background: #d1fae5;
  color: #047857;
}

.action-badge .icon-clock {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.action-badge .icon-clock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 6rpx;
  background: currentColor;
  transform: translate(-50%, -90%);
  border-radius: 2rpx;
}

.action-badge .icon-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 2rpx;
  background: currentColor;
  transform: translate(0, -50%);
  border-radius: 2rpx;
}

.action-chevron {
  color: #d6d3d1;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 400;
}
