  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.tier-badge.tier-vip {
  background: rgba(251, 191, 36, 0.22);
  border-color: rgba(217, 119, 6, 0.28);
  color: #92400e;
}

.tier-badge.tier-svip {
  background: linear-gradient(135deg, rgba(249, 115, 22, 0.22), rgba(251, 191, 36, 0.28));
  border-color: rgba(194, 65, 12, 0.35);
  color: #9a3412;
  font-weight: 700;
}

.asset-card.tier-vip {
