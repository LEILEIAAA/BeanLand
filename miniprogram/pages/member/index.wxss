.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f4;
  border: 2rpx solid rgba(28, 25, 23, 0.08);
  box-shadow:
    0 10rpx 24rpx rgba(28, 25, 23, 0.08),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
  background: #f5f5f4;
}

.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 96rpx !important;
  height: 96rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  border-radius: 50% !important;
  background: transparent !important;
  opacity: 0;
}

.avatar-hit::after {
  border: none !important;
}

.nickname-display {
  margin-top: 12rpx;
  max-width: 200rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1c1917;
  line-height: 1.3;
  text-align: center;
  word-break: break-all;
}

.asset-profile .tier-badge {
  margin-top: 8rpx;
  margin-left: 0;
}

.nickname-sync-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
