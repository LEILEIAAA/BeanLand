}

.kicker-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.9;
}

.asset-balance-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx 14rpx;
  margin-top: 22rpx;
}

.asset-balance {
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: -3rpx;
  line-height: 0.95;
  color: #1c1917;
}

.unit-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.92;
  transform: translateY(2rpx);
}

.btn-recharge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  height: 56rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #44403c;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(28, 25, 23, 0.1);
  box-shadow: 0 6rpx 16rpx rgba(28, 25, 23, 0.04);
  flex-shrink: 0;
}

.asset-hint {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.stamp-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background:
    linear-gradient(135deg, rgba(250, 204, 21, 0.12), rgba(34, 197, 94, 0.08) 45%, rgba(255, 255, 255, 0.9));
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.05);
}

.stamp-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.stamp-title {
  font-size: 30rpx;
  font-weight: 800;
}

.stamp-sub {
