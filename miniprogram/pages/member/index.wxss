.asset-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.07);
  box-shadow:
    0 20rpx 48rpx rgba(28, 25, 23, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  background:
    linear-gradient(160deg, #ffffff 0%, #fafaf9 55%, #f5f5f4 100%);
}

.asset-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.asset-glow.glow-a {
  right: -48rpx;
  top: -64rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(250, 204, 21, 0.18), transparent 70%);
}

.asset-glow.glow-b {
  left: -56rpx;
  bottom: -72rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(249, 115, 22, 0.1), transparent 72%);
}

.asset-sheen {
  position: absolute;
  left: -24%;
  top: -8%;
  width: 68%;
  height: 118%;
  background: linear-gradient(
    118deg,
    transparent 0%,
    rgba(255, 255, 255, 0.72) 38%,
    rgba(255, 255, 255, 0.18) 50%,
    transparent 64%
  );
  pointer-events: none;
}

.asset-rim {
  position: absolute;
  inset: 0;
  border-radius: 36rpx;
  pointer-events: none;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(28, 25, 23, 0.04);
}

.asset-body {
  position: relative;
  z-index: 1;
  padding: 36rpx 32rpx 32rpx;
}

.asset-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.asset-left {
  flex: 1;
  min-width: 0;
}

.asset-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.asset-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(28, 25, 23, 0.04);
  border: 1rpx solid rgba(28, 25, 23, 0.05);
