<view class="container sub-page">
  <page-loading wx:if="{{loading}}" tip="记录加载中" rows="{{4}}" />

  <block wx:elif="{{sessions.length}}">
    <view class="ss-list">
      <view class="ss-card" wx:for="{{sessions}}" wx:key="id">
        <view class="ss-row-top">
          <view class="ss-seats">{{item.tableCode}} · {{item.seatLabel || '—'}}</view>
          <view class="ss-status {{item.active ? 'active' : ''}}">{{item.statusLabel}}</view>
        </view>
        <view class="ss-date">{{item.timeRangeLabel}}</view>
        <view class="ss-time" wx:if="{{item.durationLabel}}">
          <view class="ss-duration-row">
            <view wx:if="{{item.active}}" class="icon-clock"></view>
            <text wx:if="{{item.active}}" class="ss-duration">{{item.durationLabel}}</text>
            <text wx:else class="ss-duration">时长 {{item.durationLabel}}</text>
          </view>
          <text wx:if="{{!item.active && item.isOvertime}}" class="ss-overtime">超时 {{item.overtimeLabel}}</text>
        </view>
        <view class="ss-foot" wx:if="{{item.packageName || item.amountLabel}}">
          <text wx:if="{{item.packageName}}" class="ss-pkg">{{item.packageName}}</text>
          <text wx:if="{{item.amountLabel}}" class="ss-amount">{{item.amountLabel}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="ss-empty">{{emptyTip || '暂无记录'}}</view>
</view>
