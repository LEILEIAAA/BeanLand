.ss-hint,
.ss-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
}
.ss-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ss-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 25, 23, 0.05);
}
.ss-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ss-seats {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}
.ss-status {
  font-size: 22rpx;
  color: #a8a29e;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
}
.ss-status.active {
  color: #047857;
  background: #d1fae5;
}
.ss-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a8a29e;
}
.ss-time {
  margin-top: 12rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  font-size: 26rpx;
}
.ss-duration-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.ss-duration {
  color: #1c1917;
  font-weight: 600;
}
.ss-overtime {
  color: #dc2626;
  font-weight: 600;
}
.icon-clock {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
  color: #047857;
}
.icon-clock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 7rpx;
  background: currentColor;
  transform: translate(-50%, -90%);
  border-radius: 2rpx;
}
.icon-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 2rpx;
  background: currentColor;
  transform: translate(0, -50%);
  border-radius: 2rpx;
}
.ss-foot {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ss-pkg {
  font-size: 24rpx;
  color: #78716c;
}
.ss-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #b45309;
}
