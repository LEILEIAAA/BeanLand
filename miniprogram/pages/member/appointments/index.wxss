@import "../_sub.wxss";

.coupon-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.coupon-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-tab.active {
  background: #111827;
  color: #fff;
}

.reject-reason {
  margin-top: 6rpx;
  color: #9a3412;
  font-weight: 600;
}
