.settings-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.set-group-label {
  margin: 24rpx 12rpx 14rpx;
  color: #a8a29e;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.set-group-label:first-child { margin-top: 4rpx; }

.set-card {
  border: 1rpx solid rgba(28, 25, 23, 0.06);
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(28, 25, 23, 0.03);
  overflow: hidden;
}

.set-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(28, 25, 23, 0.05);
}
.set-row:last-child { border-bottom: none; }

.set-row-label {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #1c1917;
  pointer-events: none;
}

.set-row-value {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  pointer-events: none;
}
.set-row-value-input { flex: 1; justify-content: flex-end; }
.set-text { font-size: 28rpx; color: #57534e; max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.set-text.muted { color: #a8a29e; }
.set-chevron { color: #d6d3d1; font-size: 34rpx; line-height: 1; flex-shrink: 0; }

.set-nickname-input {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  color: #57534e;
  text-align: right;
  background: transparent;
  pointer-events: auto;
}
.set-nickname-placeholder { color: #a8a29e; text-align: right; }

.set-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f4;
  border: 1rpx solid rgba(28, 25, 23, 0.05);
}

/* 透明覆盖层：整行可触发原生按钮（盖过右侧内容） */
.set-row-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  z-index: 2;
  opacity: 0;
  background: transparent;
  border: none;
  line-height: normal;
}
.set-row-hit::after { border: none; }

.set-row.tappable:active { background: rgba(28, 25, 23, 0.02); }
