<view class="container sub-page register-page">
  <view class="sub-hero">
    <view class="sub-label">会员注册</view>
    <view class="sub-value">完善资料</view>
    <view class="sub-desc">请依次选用微信头像、昵称并授权手机号。三项齐全后点底部按钮返回会员页。</view>
  </view>

  <view class="list-card register-card">
    <view class="step-row">
      <view class="step-head">
        <text class="step-no">1</text>
        <text class="step-title">微信头像</text>
        <text class="step-status {{hasAvatar ? 'done' : ''}}">{{hasAvatar ? '已选' : '未选'}}</text>
      </view>
      <view class="avatar-block">
        <view class="avatar-wrap large">
          <image class="profile-avatar large" src="{{avatarUrl}}" mode="aspectFill" />
          <button
            class="avatar-hit"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
            hover-class="none"
          ></button>
        </view>
        <view class="step-hint">点击头像选用微信头像</view>
      </view>
    </view>

    <view class="step-row">
      <view class="step-head">
        <text class="step-no">2</text>
        <text class="step-title">微信昵称</text>
        <text class="step-status {{hasNickName ? 'done' : ''}}">{{hasNickName ? '已填' : '未填'}}</text>
      </view>
      <view class="nickname-box">
        <view class="nickname-display">{{nickName || '未设置昵称'}}</view>
        <view class="nickname-sync-wrap block">
          <view class="nickname-sync-label">{{hasNickName ? '更换微信昵称' : '选用微信昵称'}}</view>
          <input
            class="nickname-sync-ghost"
            type="nickname"
            maxlength="32"
            bindblur="onNicknameBlur"
          />
        </view>
      </view>
    </view>

    <view class="step-row">
      <view class="step-head">
        <text class="step-no">3</text>
        <text class="step-title">微信手机号</text>
        <text class="step-status {{hasPhone ? 'done' : ''}}">{{hasPhone ? '已授权' : '未授权'}}</text>
      </view>
      <view wx:if="{{hasPhone}}" class="phone-masked">{{phoneMasked}}</view>
      <button
        class="btn-phone-auth"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{phoneBusy}}"
        disabled="{{phoneBusy}}"
      >{{hasPhone ? '更换微信手机号' : '授权微信手机号'}}</button>
    </view>
  </view>

  <view class="register-foot">
    <view class="progress-text">已完成 {{doneCount}}/3</view>
    <view class="btn btn-primary {{registrationComplete ? '' : 'disabled'}}" bindtap="onFinish">
      {{registrationComplete ? '完成注册并返回' : '请完成以上三项'}}
    </view>
  </view>
</view>
