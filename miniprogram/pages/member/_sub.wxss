.sub-page {
  padding-bottom: 48rpx;
}

.sub-hero {
  margin-bottom: 28rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(18px);
}

.sub-label {
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub-value {
  margin-top: 10rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  line-height: 1.1;
}

.sub-balance-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.sub-balance-row .sub-value {
  margin-top: 0;
}

.unit-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.sub-desc {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
}

.list-card {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.04);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
}

.list-row + .list-row {
  border-top: 1rpx solid rgba(17, 24, 39, 0.06);
}

.list-title {
  font-size: 28rpx;
  font-weight: 700;
}

.list-meta {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.5;
}

.list-amount {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 800;
}

.list-amount.plus { color: #166534; }
.list-amount.minus { color: #111827; }

.progress-track {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.08);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #facc15, #22c55e, #0ea5e9);
}

.status-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  font-weight: 700;
}

.status-chip.ok {
  background: #dcfce7;
  color: #166534;
}

.coupon-amount {
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.empty-tip {
  margin-top: 24rpx;
  padding: 96rpx 48rpx;
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
  line-height: 1.6;
}
