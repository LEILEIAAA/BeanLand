@import "../_sub.wxss";

.works-toolbar {
  margin-bottom: 24rpx;
}

.works-toolbar .btn {
  width: 100%;
}

.works-hint {
  padding: 48rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}

.works-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.works-cell {
  width: calc((100% - 20rpx) / 2);
  padding-bottom: 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.06);
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.works-img {
  width: 100%;
  height: 280rpx;
  display: block;
  background: #f5f5f4;
}

.works-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 16rpx 0;
}

.works-caption {
  color: #18181b;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.works-date {
  color: #9ca3af;
  font-size: 20rpx;
}

.works-del {
  margin-top: 10rpx;
  padding: 0 16rpx;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
}

.works-empty {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.05);
  text-align: center;
}

.works-empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.works-empty-desc {
  margin: 12rpx 0 32rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.works-empty .btn {
  margin: 0 auto;
  max-width: 360rpx;
}
