<view class="container">
  <view class="hero hero-frost">
    <view class="hero-bubble hero-bubble-a"></view>
    <view class="hero-bubble hero-bubble-b"></view>
    <view class="hero-bubble hero-bubble-c"></view>
    <view class="hero-bubble hero-bubble-d"></view>
    <view class="hero-bubble hero-bubble-e"></view>

    <view class="hero-copy">
      <view class="eyebrow">白底毛玻璃 · 五月天五球灵感</view>
      <view class="title">{{store.name}}</view>
      <view class="subtitle">{{store.slogan}}。适合学生、闺蜜、亲子和五月天粉丝一起到店体验。</view>
      <view class="hero-balls">
        <block wx:for="{{fiveBallPatterns}}" wx:key="key">
          <view class="ball-card {{item.key}}">
            <view class="ball-shell" style="background: {{item.color}};">
              <view class="ball-face {{item.eyes}} {{item.mouth}}" style="--eye-color: {{item.eyeColor}};"></view>
            </view>
          </view>
        </block>
      </view>
      <view class="button-row hero-actions">
        <view class="btn btn-primary" bindtap="goAppointment">立即预约</view>
        <view class="btn btn-secondary" bindtap="goRoute">到店路线</view>
      </view>
    </view>

    <view class="hero-orbital">
      <block wx:for="{{fiveBallPatterns}}" wx:key="key">
        <view class="orbital-ball {{item.key}}"></view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="grid-two">
      <block wx:for="{{highlights}}" wx:key="title">
        <view class="card glass-card">
          <view class="card-title">{{item.title}}</view>
          <view class="card-meta">{{item.meta}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">开业主推套餐</view>
      <view class="card-meta tappable" bindtap="goPackages">查看全部</view>
    </view>
    <block wx:for="{{featuredPackages}}" wx:key="id">
      <view class="card glass-card">
        <view class="card-title">{{item.name}}</view>
        <view class="card-meta">{{item.targetAudience}} · {{item.durationMinutes}} 分钟</view>
        <view class="price">¥{{item.price}}</view>
        <view class="tag-row">
          <view class="tag">{{item.overtimeRule}}</view>
          <view class="tag status-success">{{item.isRecommended ? '推荐' : '常规'}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">近期活动</view>
      <view class="card-meta tappable" bindtap="goActivities">查看全部</view>
    </view>
    <block wx:for="{{activities}}" wx:key="id">
      <view class="card glass-card">
        <view class="card-title">{{item.name}}</view>
        <view class="card-meta">限 {{item.capacity}} 人 · 报名价 ¥{{item.price}}</view>
        <view class="tag-row">
          <view class="tag">招募中</view>
          <view class="tag status-warning">{{item.status}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="card glass-card loader-card">
      <view class="card-title">加载中的灵动反馈</view>
      <view class="card-meta">圆环与五球都采用轻微缩放与漂浮效果，等待时更有活力。</view>
      <view class="loader-line">
        <view class="loader"></view>
        <view class="pulse pulse-1"></view>
        <view class="pulse pulse-2"></view>
        <view class="pulse pulse-3"></view>
      </view>
    </view>
  </view>

  <view class="custom-tabbar">
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="tab-item {{activeTab === item.key ? 'active' : ''}}" data-path="{{item.path}}" data-key="{{item.key}}" bindtap="onTabTap">
        <view class="tab-icon {{item.key}}">
          <view class="tab-ball"></view>
          <view class="tab-face"></view>
        </view>
        <view class="tab-label">{{item.label}}</view>
      </view>
    </block>
  </view>
</view>
