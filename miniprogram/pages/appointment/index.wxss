.seat-page {
  padding-bottom: 40rpx;
}

.form-sub {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.date-options {
  display: flex;
  gap: 16rpx;
}

.date-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(17, 24, 39, 0.05);
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.date-chip.is-on {
  background: #111827;
  color: #fff;
}

.assign-meta {
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 600;
}

.top-panel {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(16px);
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.today-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.06);
  color: #111827;
  font-size: 22rpx;
  font-weight: 700;
}

.people-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.people-label {
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
}

.people-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
}

.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #111827;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.stepper-btn.is-disabled {
  opacity: 0.28;
}

.form-item-slots {
  margin-bottom: 28rpx;
}

.form-item-slots .label {
  margin-bottom: 14rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.slot-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.slot-chip.is-on {
  color: #fff;
  background: #111827;
  border-color: #111827;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6b7280;
  font-size: 20rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot.available { background: #4ade80; }
.dot.booked { background: #fbbf24; }
.dot.unavailable { background: #cbd5e1; }
.dot.selected { background: #111827; }

.floor-map {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.table-island {
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.045);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.table-island.is-active {
  border-color: rgba(17, 24, 39, 0.2);
  box-shadow: 0 16rpx 40rpx rgba(17, 24, 39, 0.1);
}

.table-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.table-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.table-name {
  font-size: 30rpx;
  font-weight: 800;
}

.table-area {
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
}

.table-avail {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 20rpx;
  font-weight: 700;
}

.table-avail.is-zero {
  background: #f1f5f9;
  color: #94a3b8;
}

.seat-grid {
  display: grid;
  gap: 12rpx;
}

.seat-grid-1 { grid-template-columns: repeat(1, 1fr); }
.seat-grid-2 { grid-template-columns: repeat(2, 1fr); }
.seat-grid-3 { grid-template-columns: repeat(3, 1fr); }
.seat-grid-4 { grid-template-columns: repeat(4, 1fr); }

.seat {
  min-height: 112rpx;
  padding: 14rpx 8rpx;
  border-radius: 24rpx;
  text-align: center;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.seat-index {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.seat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.seat-available {
  color: #166534;
  background: linear-gradient(180deg, #ecfdf5, #d1fae5);
}

.seat-booked {
  color: #92400e;
  background: #fff7ed;
}

.seat-unavailable {
  color: #94a3b8;
  background: #f1f5f9;
}

.seat.is-selected {
  color: #fff;
  background: #111827;
  border-color: #111827;
  box-shadow: 0 12rpx 24rpx rgba(17, 24, 39, 0.22);
  transform: translateY(-2rpx);
}

.map-spacer {
  height: 180rpx;
}

.map-foot {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 16rpx 18rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.16);
  backdrop-filter: blur(18px);
}

.progress-track {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.08);
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #facc15, #22c55e, #0ea5e9);
  transition: width 0.2s ease;
}

.map-foot-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.map-foot-copy {
  flex: 1;
  min-width: 0;
}

.map-foot-title {
  font-size: 26rpx;
  font-weight: 800;
}

.map-foot-meta {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-foot-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.btn-ghost {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #374151;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-foot-btn {
  min-width: 168rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.map-foot-btn.is-disabled {
  opacity: 0.42;
}

.form-hero {
  margin-bottom: 22rpx;
}

.step-dots {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.step-dot {
  width: 28rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.12);
}

.step-dot.done,
.step-dot.on {
  background: #111827;
}

.form-back {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.seat-summary {
  position: relative;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(17, 24, 39, 0.045);
  border: 1rpx solid rgba(17, 24, 39, 0.05);
}

.seat-summary-main {
  font-size: 28rpx;
  font-weight: 800;
  padding-right: 120rpx;
}

.seat-summary-meta {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.seat-summary-link {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #111827;
  font-size: 22rpx;
  font-weight: 700;
}

.form-card {
  margin-bottom: 22rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.row-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.picker {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  font-size: 28rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-extra {
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 700;
}

.note-input {
  min-height: 140rpx;
  width: 100%;
  box-sizing: border-box;
}

.agree-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.form-spacer {
  height: 140rpx;
}

.form-foot {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.profile-bar {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.profile-avatar-btn {
  margin: 0;
  padding: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-fields {
  flex: 1;
  min-width: 0;
}

.nickname-display {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.4;
  word-break: break-all;
}

.nickname-sync-input {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.profile-hint {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.profile-hint.warn {
  color: #9a3412;
}

.success-card {
  border: 1rpx solid rgba(34, 197, 94, 0.18);
  background: linear-gradient(180deg, rgba(220, 252, 231, 0.55), rgba(255, 255, 255, 0.92));
}

.success-badge {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #166534;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.success-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.success-label {
  color: #9ca3af;
  font-size: 20rpx;
  font-weight: 600;
}

.success-value {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
