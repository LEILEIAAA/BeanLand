<view class="container seat-page">
  <!-- 店主确认选座 -->
  <block wx:if="{{mode === 'assign'}}">
    <view class="top-panel">
      <view class="top-row">
        <view class="today-pill">{{todayDisplay}} · {{form.peopleCount}} 人</view>
        <view class="assign-meta">{{selectedSlotLabel}}</view>
      </view>
      <view class="legend">
        <view class="legend-item"><view class="dot available"></view>可约</view>
        <view class="legend-item"><view class="dot booked"></view>已约</view>
        <view class="legend-item"><view class="dot unavailable"></view>不可约</view>
        <view class="legend-item"><view class="dot selected"></view>已选</view>
      </view>
    </view>

    <view class="floor-map">
      <block wx:for="{{seatGroups}}" wx:key="tableCode">
        <view class="table-island {{item.hasSelected ? 'is-active' : ''}}">
          <view class="table-head">
            <view class="table-title-wrap">
              <view class="table-name">{{item.tableCode}}</view>
              <view class="table-area">{{item.area}}</view>
            </view>
            <view class="table-avail {{item.availableCount ? '' : 'is-zero'}}">
              {{item.availableCount ? item.availableCount + ' 可约' : '已满'}}
            </view>
          </view>
          <view class="seat-grid seat-grid-{{item.seats.length > 4 ? 4 : item.seats.length}}">
            <block wx:for="{{item.seats}}" wx:for-item="seat" wx:key="id">
              <view
                class="seat seat-{{seat.status}} {{seat.selected ? 'is-selected' : ''}}"
                data-seat-id="{{seat.id}}"
                data-status="{{seat.status}}"
                bindtap="onSeatTap"
              >
                <view class="seat-index">{{seat.index}}</view>
                <view class="seat-label">{{seat.selected ? '已选' : seat.statusLabel}}</view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <view class="map-spacer"></view>
    <view class="map-foot is-show">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{selectProgress}}%;"></view>
      </view>
      <view class="map-foot-main">
        <view class="map-foot-copy">
          <view class="map-foot-title">已选 {{selectedSeatIds.length}}/{{form.peopleCount}}</view>
          <view class="map-foot-meta" wx:if="{{selectedSeatLabel}}">{{selectedSeatLabel}}</view>
          <view class="map-foot-meta" wx:else>点可约座位完成排座</view>
        </view>
        <view class="map-foot-actions">
          <view class="btn btn-ghost" wx:if="{{selectedSeatIds.length}}" bindtap="clearSelection">清空</view>
          <view
            class="btn btn-primary map-foot-btn {{canGoForm && !submitting ? '' : 'is-disabled'}}"
            bindtap="submit"
          >确认排座</view>
        </view>
      </view>
    </view>
  </block>

  <!-- C 端登记：未完成注册不展示可提交表单 -->
  <block wx:elif="{{memberReady}}">
    <view class="form-hero">
      <view class="form-title">预约开拼</view>
      <view class="form-sub">登记意向后由店主确认排座，不占座</view>
    </view>

    <view class="newmap-entry" style="display:flex;align-items:center;justify-content:space-between;background:#2a2420;color:#fff;border-radius:20rpx;padding:24rpx 28rpx;margin-bottom:20rpx;" bindtap="goSeatBooking">
      <view>
        <view style="font-size:28rpx;font-weight:600;">地图选座预约（新版）</view>
        <view style="font-size:22rpx;opacity:.8;margin-top:6rpx;">按座位图直接选座·全天畅玩或自选时段</view>
      </view>
      <view style="font-size:36rpx;opacity:.7;">›</view>
    </view>

    <view class="card form-card">
      <view class="form-item">
        <view class="label">预约日期</view>
        <view class="date-options">
          <block wx:for="{{dateOptions}}" wx:key="value">
            <view
              class="date-chip {{form.appointmentDate === item.value ? 'is-on' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectDate"
            >{{item.label}}</view>
          </block>
        </view>
      </view>

      <view class="form-item form-item-slots">
        <view class="label">时段（可连续多选）</view>
        <view class="slot-grid">
          <block wx:for="{{slotChips}}" wx:key="index">
            <view
              class="slot-chip {{item.selected ? 'is-on' : ''}}"
              data-index="{{item.index}}"
              bindtap="onSlotTap"
            >{{item.label}}</view>
          </block>
        </view>
      </view>

      <view class="form-item">
        <view class="label">到店人数</view>
        <view class="people-control">
          <view class="stepper-btn {{form.peopleCount <= 1 ? 'is-disabled' : ''}}" data-delta="-1" bindtap="changePeople">-</view>
          <text class="people-num">{{form.peopleCount}}</text>
          <view class="stepper-btn {{form.peopleCount >= 6 ? 'is-disabled' : ''}}" data-delta="1" bindtap="changePeople">+</view>
        </view>
      </view>

      <view class="profile-bar">
        <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
        </button>
        <view class="profile-fields">
          <view class="label">预约昵称</view>
          <view class="nickname-display">{{form.name}}</view>
          <block wx:if="{{showSyncHints}}">
            <input
              class="input nickname-sync-input"
              type="nickname"
              maxlength="32"
              placeholder="点按可同步昵称"
              bindblur="onNicknameBlur"
            />
          </block>
        </view>
      </view>

      <view class="form-item">
        <view class="label">手机号</view>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="用于确认预约"
          value="{{form.phone}}"
          data-field="phone"
          bindinput="updateField"
        />
      </view>

      <view class="form-item">
        <view class="label">来源渠道</view>
        <picker range="{{sourceOptions}}" value="{{sourceIndex}}" bindchange="onSourceChange">
          <view class="picker">{{sourceOptions[sourceIndex]}}</view>
        </picker>
      </view>

      <checkbox-group bindchange="toggleAgree">
        <label class="agree-label">
          <checkbox value="agree" checked="{{form.agreed}}" color="#111827" />
          <text>我已了解：提交后待店主确认，确认前不占座</text>
        </label>
      </checkbox-group>
    </view>

    <view class="card success-card" wx:if="{{summary}}">
      <view class="success-badge">{{summary.statusLabel || '待商家确认'}}</view>
      <view class="card-title">{{summary.title}}</view>
      <view class="success-grid">
        <view class="success-item">
          <view class="success-label">时间</view>
          <view class="success-value">{{summary.appointmentDate}} {{summary.timeSlot}}</view>
        </view>
        <view class="success-item">
          <view class="success-label">到店人数</view>
          <view class="success-value">{{summary.peopleCount}} 人</view>
        </view>
      </view>
      <view class="card-meta" style="margin-top: 16rpx;">店主确认排座后会通知你，前往我的预约查看。</view>
    </view>

    <view class="form-spacer"></view>
    <view class="form-foot" wx:if="{{!summary}}">
      <view class="btn btn-primary {{submitting ? 'is-disabled' : ''}}" bindtap="submit">提交预约</view>
    </view>
  </block>

  <block wx:else>
    <view class="form-hero">
      <view class="form-title">预约开拼</view>
      <view class="form-sub">需先完成会员注册（头像、昵称、手机号）</view>
    </view>
  </block>
</view>
