.recharge-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(120% 55% at 100% -8%, rgba(255, 184, 10, 0.2), transparent 55%),
    radial-gradient(90% 45% at 0% 12%, rgba(255, 61, 2, 0.08), transparent 50%),
    #fafafa;
}

.rc-hero {
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx 0;
}

.rc-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #d97706;
  letter-spacing: 1rpx;
}

.rc-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #18181b;
  line-height: 1.2;
}

.rc-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #71717a;
}

.rc-tier {
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 184, 10, 0.16), rgba(255, 61, 2, 0.08));
  border: 1rpx solid rgba(255, 184, 10, 0.35);
}

.rc-tier-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #92400e;
}

.rc-tier-body {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #a16207;
}

.rc-section-label {
  margin: 8rpx 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #a1a1aa;
  letter-spacing: 1rpx;
}

.rc-list {
  margin-bottom: 8rpx;
}

.rc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 12rpx rgba(24, 24, 27, 0.03);
}

.rc-item.is-on {
  border-color: #ffb80a;
  background: #fffbeb;
}

.rc-item-main {
  flex: 1;
  min-width: 0;
}

.rc-item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #18181b;
  line-height: 1.3;
}

.rc-item-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #a1a1aa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-item-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rc-item-price {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #ea580c;
}

.rc-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d4d4d8;
  box-sizing: border-box;
  background: #fff;
}

.rc-radio.is-on {
  border-color: #ffb80a;
  border-width: 10rpx;
  background: #fff;
}

.rc-tip {
  margin: 20rpx 4rpx 0;
  font-size: 22rpx;
  line-height: 1.65;
  color: #a1a1aa;
}

.rc-spacer {
  height: 24rpx;
}

.rc-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(24, 24, 27, 0.06);
}

.rc-bar-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #71717a;
  font-weight: 600;
}

.rc-bar-sep {
  color: #d4d4d8;
}

.rc-btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #18181b;
  background: linear-gradient(90deg, #ffd35a 0%, #ffb80a 100%);
  box-shadow: 0 10rpx 24rpx rgba(255, 184, 10, 0.35);
}

.rc-btn.is-disabled {
  opacity: 0.4;
  pointer-events: none;
  box-shadow: none;
}
