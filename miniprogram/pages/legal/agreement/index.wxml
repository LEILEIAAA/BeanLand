<view class="container legal-page">
  <view class="legal-hero">
    <view class="legal-title">用户协议</view>
    <view class="legal-updated">更新日期 {{updatedAt}}</view>
  </view>

  <view class="legal-card">
    <block wx:for="{{sections}}" wx:key="title">
      <view class="legal-section">
        <view class="legal-section-title">{{item.title}}</view>
        <view wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this" class="legal-p">{{p}}</view>
        <view wx:if="{{item.items}}" class="legal-list">
          <view wx:for="{{item.items}}" wx:for-item="li" wx:key="*this" class="legal-li">
            <text class="legal-dot">·</text>
            <text class="legal-li-text">{{li}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
