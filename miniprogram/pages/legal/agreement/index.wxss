.legal-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.legal-hero { padding: 12rpx 8rpx 24rpx; }
.legal-title { font-size: 44rpx; font-weight: 800; letter-spacing: -0.5rpx; color: #18181b; }
.legal-updated { margin-top: 12rpx; color: #a8a29e; font-size: 24rpx; }

.legal-card {
  padding: 12rpx 28rpx 8rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.06);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(28, 25, 23, 0.03);
}

.legal-section { padding: 24rpx 0; border-bottom: 1rpx solid rgba(28, 25, 23, 0.05); }
.legal-section:last-child { border-bottom: none; }
.legal-section-title { font-size: 30rpx; font-weight: 700; color: #1c1917; margin-bottom: 14rpx; }
.legal-p { color: #57534e; font-size: 27rpx; line-height: 1.78; margin-top: 8rpx; }

.legal-list { margin-top: 10rpx; }
.legal-li { display: flex; align-items: flex-start; margin-top: 8rpx; }
.legal-dot { color: #a8a29e; font-size: 27rpx; line-height: 1.78; margin-right: 10rpx; }
.legal-li-text { flex: 1; color: #57534e; font-size: 27rpx; line-height: 1.78; }
