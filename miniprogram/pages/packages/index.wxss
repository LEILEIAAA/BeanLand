.menu-head {
  margin: 0 0 36rpx;
  padding: 4rpx 2rpx 8rpx;
}

.menu-head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.menu-head-main {
  flex: 1;
  min-width: 0;
}

.menu-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #a1a1aa;
  text-transform: uppercase;
}

.menu-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  line-height: 1.05;
  color: #18181b;
}

.menu-count {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding-bottom: 6rpx;
}

.menu-count-num {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  color: #ffb80a;
  line-height: 1;
}

.menu-count-unit {
  font-size: 22rpx;
  font-weight: 700;
  color: #71717a;
}

.menu-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.menu-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f4f5;
  color: #52525b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.menu-tag.is-promo {
  background: rgba(255, 61, 2, 0.1);
  color: #ff3d02;
  font-weight: 700;
}

.pkg-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.08);
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(24, 24, 27, 0.05);
}

.pkg-card.is-hot {
  border-color: rgba(255, 61, 2, 0.28);
  background: linear-gradient(180deg, #fff7f5 0%, #ffffff 48%);
}

.pkg-ribbon {
  position: absolute;
  top: 28rpx;
  right: -52rpx;
  z-index: 3;
  width: 200rpx;
  padding: 12rpx 0;
  background: linear-gradient(90deg, #ff3d02 0%, #ff6a3d 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 61, 2, 0.35);
  transform: rotate(45deg);
  text-align: center;
}

.pkg-ribbon.tone-deal {
  background: linear-gradient(90deg, #ffb80a 0%, #ffd35a 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 184, 10, 0.4);
}

.pkg-ribbon.tone-deal .pkg-ribbon-text {
  color: #18181b;
}

.pkg-ribbon-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.pkg-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 36rpx;
  padding-right: 72rpx;
}

.pkg-index {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #ffb80a;
}

.pkg-name {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #18181b;
}

.pkg-meta {
  margin-top: 8rpx;
  color: #71717a;
  font-size: 24rpx;
  font-weight: 500;
}

.pkg-price-board {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.pkg-price-row {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(24, 24, 27, 0.08);
  background: #fafaf9;
}

.pkg-price-row.is-today {
  border-color: rgba(255, 184, 10, 0.55);
  background: rgba(255, 184, 10, 0.12);
}

.pkg-price-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.pkg-price-label {
  color: #71717a;
  font-size: 20rpx;
  font-weight: 700;
}

.pkg-price-pick {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #18181b;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.pkg-price-value {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #18181b;
}

.pkg-sale {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
  margin-bottom: 36rpx;
}

.pkg-sale-label {
  color: #71717a;
  font-size: 22rpx;
  font-weight: 600;
}

.pkg-sale-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff3d02;
  letter-spacing: -1rpx;
}

.pkg-sale-base {
  color: #a1a1aa;
  font-size: 22rpx;
  text-decoration: line-through;
}

.pkg-includes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 28rpx;
}

.pkg-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f4f5;
  color: #3f3f46;
  font-size: 20rpx;
  font-weight: 600;
}

.btn {
  flex: 1;
}

.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.buy-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(24, 24, 27, 0.45);
}

.buy-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(24, 24, 27, 0.12);
}

.buy-sheet-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #18181b;
}

.buy-sheet-name {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #18181b;
  line-height: 1.35;
}

.buy-sheet-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #3f3f46;
}

.buy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.buy-row.settle {
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f4f4f5;
}

.buy-row.total {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(28, 25, 23, 0.1);
}

.buy-label {
  color: #3f3f46;
  font-size: 28rpx;
  font-weight: 600;
}

.buy-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #18181b;
}

.buy-value.emphasis {
  color: #ff3d02;
  font-size: 36rpx;
}

.buy-section-label {
  margin-top: 40rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #18181b;
}

.coupon-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  background: #fafaf9;
}

.coupon-option.selected {
  border-color: #1c1917;
  background: #fff;
}

.coupon-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #18181b;
}

.coupon-meta {
  color: #52525b;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-empty {
  color: #71717a;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 0 4rpx;
}

.coupon-blocked {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 184, 10, 0.14);
  color: #854d0e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.pay-method-row {
  display: flex;
  gap: 16rpx;
}

.pay-method {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.1);
  background: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.pay-method.selected {
  color: #fff;
  background: #1c1917;
  border-color: #1c1917;
}

.buy-tip {
  margin-top: 12rpx;
  color: #78716c;
  font-size: 22rpx;
}

.buy-actions {
  margin-top: 36rpx;
}

.buy-actions .btn {
  width: 100%;
}
