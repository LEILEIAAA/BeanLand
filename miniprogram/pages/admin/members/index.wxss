.field-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  background: #fafaf9;
  color: #1c1917;
  font-size: 28rpx;
}

.field-input-flex {
  flex: 1;
  width: auto;
  min-width: 0;
}

.field-placeholder {
  color: #a8a29e;
}

.search-btn {
  flex: 0 0 auto;
  min-width: 160rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.card-topline {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.status-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 800;
}
