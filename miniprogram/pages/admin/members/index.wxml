<view class="container">
  <view class="section-title">会员管理</view>
  <view class="subtitle">按手机号、尾号或昵称查找。列表展示等级与余额。</view>

  <view class="card section">
    <view class="field-row">
      <input
        class="field-input field-input-flex"
        placeholder="手机号/尾号(≥4位)/昵称"
        placeholder-class="field-placeholder"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="btn btn-secondary search-btn" bindtap="onSearch">查找</view>
    </view>
  </view>

  <page-loading wx:if="{{loading}}" tip="会员加载中" rows="{{4}}" />

  <view class="subtitle" wx:elif="{{!list.length}}" style="margin-top: 24rpx;">暂无会员</view>

  <block wx:else>
    <block wx:for="{{list}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="goDetail">
        <view class="card-topline">
          <view>
            <view class="card-title">{{item.nickname}}</view>
            <view class="card-meta">{{item.phone}}</view>
          </view>
          <view class="status-badge">{{item.tierLabel}}</view>
        </view>
        <view class="card-meta">余额 ¥{{item.balanceText}}</view>
      </view>
    </block>
  </block>
</view>
