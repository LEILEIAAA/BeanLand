.form-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.form-label {
  font-size: 26rpx;
  color: #57534e;
  font-weight: 600;
}

.req {
  color: #dc2626;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  background: #fafaf9;
  color: #1c1917;
  font-size: 28rpx;
}

.picker-input {
  display: flex;
  align-items: center;
}

.field-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  background: #fafaf9;
  color: #1c1917;
  font-size: 28rpx;
}

.cover-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cover-preview {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
}

.cover-ops {
  display: flex;
  gap: 16rpx;
}

.cover-btn {
  flex: 1;
  min-height: 68rpx;
  font-size: 26rpx;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 240rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(28, 25, 23, 0.18);
  background: #fafaf9;
}

.cover-empty-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  line-height: inherit;
  font-weight: inherit;
  box-sizing: border-box;
}

.cover-empty-btn::after {
  border: none;
}

.cover-plus {
  font-size: 56rpx;
  color: #a8a29e;
  line-height: 1;
}

.cover-tip {
  font-size: 24rpx;
  color: #a8a29e;
}

.btn-danger {
  color: #dc2626;
  background: #fff;
  border: 1rpx solid rgba(220, 38, 38, 0.3);
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.accent-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.badge-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.badge-dot.is-active {
  border-color: #1c1917;
  box-shadow: 0 0 0 2rpx #fff inset;
}

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-body {
  padding: 28rpx;
}

.edit-footer {
  flex: none;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid rgba(28, 25, 23, 0.06);
}

.save-btn {
  width: 100%;
}

.is-disabled {
  opacity: 0.5;
}
