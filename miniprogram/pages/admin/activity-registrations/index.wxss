.admin-hero {
  margin-bottom: 24rpx;
}

.filter-row {
  margin-top: 28rpx;
}

.filter-tag {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1c1917;
  background: #f5f5f4;
  border: 1rpx solid transparent;
}

.filter-tag.is-on {
  color: #9a3412;
  background: #ffedd5;
  border-color: rgba(249, 115, 22, 0.35);
}

.combined-card {
  border: 1rpx solid rgba(249, 115, 22, 0.16);
}

.card-topline {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.status-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status-badge.warn {
  background: #fee2e2;
  color: #991b1b;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.btn-mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  flex: 0 0 auto;
}

.btn-mini-primary {
  color: #fff;
  background: #1c1917;
  box-shadow: 0 6rpx 16rpx rgba(28, 25, 23, 0.12);
}
