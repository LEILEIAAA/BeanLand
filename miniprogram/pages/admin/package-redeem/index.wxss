@import "../../member/_sub.wxss";

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
  color: #111827;
}

.page-title + .sub-desc {
  margin-top: 10rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 600;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input-flex {
  flex: 1;
  width: auto;
  min-width: 0;
}

.search-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.member-row {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.member-row.active {
  background: rgba(16, 185, 129, 0.06);
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 16rpx;
}

.coupon-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.redeem-btn {
  margin-top: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #111827;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.redeem-btn-busy {
  opacity: 0.5;
}

.empty-tip {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 1.5;
}
