page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-body {
  padding: 28rpx;
}

.subtitle {
  margin: 8rpx 0 24rpx;
  font-size: 24rpx;
  color: #a8a29e;
  line-height: 1.6;
}

.banner-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.banner-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.banner-no {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}

.banner-order {
  display: flex;
  gap: 12rpx;
}

.order-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.12);
  background: #fafaf9;
  font-size: 24rpx;
  color: #57534e;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  font-size: 26rpx;
  color: #57534e;
  font-weight: 600;
}

.req {
  color: #dc2626;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.08);
  background: #fafaf9;
  color: #1c1917;
  font-size: 28rpx;
}

.cover-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cover-preview {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
}

.cover-ops {
  display: flex;
  gap: 16rpx;
}

.cover-btn {
  flex: 1;
  min-height: 68rpx;
  font-size: 26rpx;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 300rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(28, 25, 23, 0.18);
  background: #fafaf9;
}

.cover-plus {
  font-size: 56rpx;
  color: #a8a29e;
  line-height: 1;
}

.cover-tip {
  font-size: 24rpx;
  color: #a8a29e;
}

.btn-danger {
  color: #dc2626;
  background: #fff;
  border: 1rpx solid rgba(220, 38, 38, 0.3);
}

.add-btn {
  width: 100%;
  margin-top: 8rpx;
}

.edit-footer {
  flex: none;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid rgba(28, 25, 23, 0.06);
}

.save-btn {
  width: 100%;
}

.is-disabled {
  opacity: 0.5;
}
