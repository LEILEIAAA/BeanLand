<view class="container">
  <view class="section-title">店主看板</view>
  <view class="subtitle">开业期预约、会员储值与座位压力。指标看板后续接云。</view>

  <view class="section">
    <view class="btn btn-primary" bindtap="goCoupons">优惠券核销 / 发放</view>
    <view class="btn btn-secondary" style="margin-top: 16rpx;" bindtap="goPackages">套餐核销</view>
    <view class="btn btn-secondary" style="margin-top: 16rpx;" bindtap="goAppointments">预约管理</view>
    <view class="btn btn-secondary" style="margin-top: 16rpx;" bindtap="goActivityRegs">活动报名管理</view>
    <view class="btn btn-secondary" style="margin-top: 16rpx;" bindtap="goTimer">座位管理</view>
    <view class="btn btn-secondary" style="margin-top: 16rpx;" bindtap="goTimerHistory">计时复盘</view>
  </view>

  <view class="grid-two section">
    <block wx:for="{{metrics}}" wx:key="label">
      <view class="card">
        <view class="card-meta">{{item.label}}</view>
        <view class="price">{{item.value}}</view>
      </view>
    </block>
  </view>
</view>
