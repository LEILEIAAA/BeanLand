<view class="container dash">
  <view class="dash-hero">
    <view class="dash-hero-title">店主看板</view>
    <view class="dash-hero-desc">日常开台结账，接待预约与活动；核销套餐券，复盘时查会员资金。</view>
  </view>

  <block wx:for="{{sections}}" wx:key="key">
    <view class="dash-section {{item.emphasis ? 'dash-section-emphasis' : ''}}">
      <view class="dash-section-head">
        <view class="dash-section-title">{{item.title}}</view>
        <view wx:if="{{item.emphasis}}" class="dash-section-tag">常用</view>
      </view>
      <view class="dash-grid">
        <block wx:for="{{item.items}}" wx:for-item="entry" wx:key="key">
          <view
            class="dash-tile {{item.emphasis ? 'dash-tile-emphasis' : ''}}"
            hover-class="dash-tile-hover"
            hover-stay-time="80"
            data-url="{{entry.url}}"
            bindtap="goMenu"
          >
            <view class="dash-tile-label">
              <text>{{entry.label}}</text>
              <view wx:if="{{entry.badge}}" class="dash-badge">{{entry.badge}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
