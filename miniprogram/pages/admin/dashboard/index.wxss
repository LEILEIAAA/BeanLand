page {
  background: #f8fafc;
}

.dash {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
}

.dash-hero {
  margin: 4rpx 0 8rpx;
  padding: 8rpx 4rpx 4rpx;
}

.dash-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: #0f172a;
  line-height: 1.2;
}

.dash-hero-desc {
  margin-top: 14rpx;
  max-width: 640rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.65;
}

.dash-section {
  margin-top: 36rpx;
}

.dash-section-emphasis {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: #0f172a;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.16);
}

.dash-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.dash-section-title {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.dash-section-emphasis .dash-section-title {
  color: rgba(255, 255, 255, 0.72);
}

.dash-section-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #f8fafc;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.dash-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  overflow: visible;
}

.dash-tile {
  position: relative;
  box-sizing: border-box;
  width: calc((100% - 16rpx) / 2);
  min-height: 120rpx;
  padding: 30rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow: visible;
}

.dash-tile-emphasis {
  color: #0f172a;
  background: #ffffff;
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.18);
}

.dash-tile-hover {
  opacity: 0.88;
  transform: scale(0.98);
}

.dash-tile-label {
  position: relative;
  display: inline-block;
  max-width: 100%;
  line-height: 1.3;
}

.dash-badge {
  position: absolute;
  top: -14rpx;
  left: 100%;
  z-index: 2;
  box-sizing: border-box;
  margin-left: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fa5151;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  pointer-events: none;
}
