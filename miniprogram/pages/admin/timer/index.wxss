.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  background: #f8fafc;
}

.assign-banner {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #0f172a;
  color: #fff;
}

.assign-banner-title {
  font-size: 30rpx;
  font-weight: 700;
}

.assign-banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.assign-banner-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.assign-progress-track {
  height: 8rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.assign-progress-fill {
  height: 100%;
  background: #0f172a;
}

.assign-actions {
  margin-top: 12rpx;
  gap: 12rpx;
}

.assign-actions .dock-start {
  flex: 1;
}

.dock-ghost {
  flex: 0 0 auto;
  height: 72rpx;
  min-width: 120rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

/* 主角：座位图 */
.map-stage {
  padding: 8rpx 8rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.04);
  min-height: 62vh;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 8rpx 8rpx 4rpx;
}

.filter-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.filter-chip.is-on {
  background: #0f172a;
  color: #fff;
  font-weight: 600;
}

.map-empty {
  padding: 48rpx 16rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.table-block {
  margin-top: 18rpx;
  padding: 16rpx 8rpx 8rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.table-block:first-of-type {
  border-top: none;
}

.table-title {
  margin: 0 8rpx 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.seat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.seat {
  min-width: 150rpx;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  text-align: center;
}

.seat-id {
  font-size: 24rpx;
  font-weight: 700;
}

.seat-status,
.seat-remain {
  margin-top: 6rpx;
  font-size: 20rpx;
}

.seat-idle {
  color: #166534;
  background: #dcfce7;
}

.seat-reserved {
  color: #92400e;
  background: #fef3c7;
}

.seat-in_use {
  color: #075985;
  background: #e0f2fe;
}

.seat-maintenance {
  color: #64748b;
  background: #e2e8f0;
}

.seat.is-selected {
  outline: 4rpx solid #111827;
}

.seat.is-locked {
  opacity: 0.42;
}

.seat-time-main {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.seat-time-sub {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

.seat-time-sub.is-warn {
  color: #991b1b;
  font-weight: 600;
}

/* 底部开台操作条 */
.dock-spacer {
  height: 320rpx;
}

.start-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.dock-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dock-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  font-size: 26rpx;
  box-sizing: border-box;
}

.dock-duration {
  flex: 0 0 auto;
  height: 72rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #334155;
  white-space: nowrap;
}

.dock-start {
  flex: 0 0 auto;
  height: 72rpx;
  min-width: 120rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #cbd5e1;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 700;
}

.dock-start.is-ready {
  background: #0f172a;
  color: #fff;
}

.dock-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.pair-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #475569;
}

.member-select {
  position: relative;
}

.member-dropdown {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100% + 12rpx);
  max-height: 360rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 16rpx;
  background: #fff;
  padding: 8rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.12);
  z-index: 50;
}

.member-item {
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 24rpx;
}

.member-item.is-on {
  background: #e0f2fe;
  font-weight: 600;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #075985;
  font-size: 22rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-elapsed,
.tag-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.tag-warn {
  background: #fee2e2;
  color: #991b1b;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 90;
}

.session-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.12);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 20rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.sheet-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.sheet-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  min-height: 72rpx;
  font-size: 26rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 700;
}

.btn-primary {
  color: #fff;
  background: #1c1917;
}

.btn-secondary {
  color: #1c1917;
  background: #fff;
  border: 1rpx solid rgba(28, 25, 23, 0.1);
}

.card-meta {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.icon-clock {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-clock::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 7rpx;
  background: currentColor;
  transform: translate(-50%, -90%);
  border-radius: 2rpx;
}

.icon-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 2rpx;
  background: currentColor;
  transform: translate(0, -50%);
  border-radius: 2rpx;
}

.icon-remaining {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 20rpx;
  height: 18rpx;
  flex-shrink: 0;
}

.icon-remaining .bar {
  width: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.icon-remaining .bar:nth-child(1) {
  height: 6rpx;
}

.icon-remaining .bar:nth-child(2) {
  height: 11rpx;
}

.icon-remaining .bar:nth-child(3) {
  height: 18rpx;
}

.icon-overtime {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-overtime::before,
.icon-overtime::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: currentColor;
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

.icon-overtime::before {
  width: 10rpx;
  height: 2rpx;
}

.icon-overtime::after {
  width: 2rpx;
  height: 10rpx;
}
