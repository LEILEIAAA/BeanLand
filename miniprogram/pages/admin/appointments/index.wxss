.admin-hero {
  margin-bottom: 24rpx;
}

.combined-card {
  border: 1rpx solid rgba(249, 115, 22, 0.16);
}

.card-topline {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.status-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 800;
}

.spark-line {
  display: flex;
  gap: 10rpx;
  margin: 20rpx 0 16rpx;
}

.spark-step {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(251, 146, 60, 0.18);
}

.spark-step.current,
.spark-step.active {
  background: linear-gradient(90deg, #fb923c, #f97316);
}

.spark-step.warning {
  background: linear-gradient(90deg, #fb7185, #f97316);
}

.button-row {
  flex-wrap: wrap;
}

.btn {
  flex: 1 1 46%;
}
