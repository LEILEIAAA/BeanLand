.create-btn {
  margin: 8rpx 0 24rpx;
  width: 100%;
}

.list-area {
  min-height: 240rpx;
}

.list-loading {
  margin-top: 24rpx;
  padding: 32rpx 0;
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
}

.card-topline {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.shelf-badge {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.shelf-on {
  background: #dcfce7;
  color: #166534;
}

.shelf-off {
  background: #f5f5f4;
  color: #a8a29e;
}

.row-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.act-btn {
  flex: 1;
  min-height: 68rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
}

.btn-danger {
  color: #dc2626;
  background: #fff;
  border: 1rpx solid rgba(220, 38, 38, 0.3);
}
