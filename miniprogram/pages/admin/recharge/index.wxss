.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.field-input {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.member-row {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.member-row.active {
  outline: 2rpx solid #111827;
}

.btn.disabled {
  opacity: 0.5;
}
