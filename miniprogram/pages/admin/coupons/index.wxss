@import "../../member/_sub.wxss";

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.field-input {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.member-row {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.member-row.active {
  outline: 2rpx solid #111827;
}

.coupon-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.coupon-amount {
  font-size: 32rpx;
  font-weight: 800;
}

.redeem-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  min-width: auto;
}

.coupon-dimmed {
  opacity: 0.55;
}

.btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.empty-tip {
  margin-top: 48rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
