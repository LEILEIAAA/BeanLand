@import "../../member/_sub.wxss";

.page-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
  color: #111827;
}

.page-title + .sub-desc {
  margin-top: 10rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 600;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.4;
}

.field-input-flex {
  flex: 1;
  width: auto;
  min-width: 0;
}

.field-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.search-btn {
  flex-shrink: 0;
  min-width: 140rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
}

picker {
  display: block;
  width: 100%;
}

.picker-trigger {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #f8fafc;
}

.picker-value {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.picker-extra {
  color: #9ca3af;
  font-size: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.date-quick-row {
  margin-top: 14rpx;
}

.chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 2rpx solid rgba(17, 24, 39, 0.08);
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.chip-active {
  background: #111827;
  border-color: #111827;
  color: #fff;
}

.chip-soft {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  background: #fff;
  border-color: rgba(17, 24, 39, 0.12);
}

.preview-box {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.member-row {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid transparent;
}

.member-row.active {
  border-color: #111827;
  background: #fff;
}

.coupon-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.coupon-amount {
  font-size: 32rpx;
  font-weight: 800;
}

.redeem-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #111827;
  background: #fff;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.redeem-btn-disabled {
  border-color: #d1d5db;
  background: #f3f4f6;
  color: #9ca3af;
  pointer-events: none;
}

.coupon-dimmed {
  opacity: 0.55;
}

.btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.empty-tip {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 1.5;
}

.op-panel {
  margin-top: 28rpx;
}

.coupon-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.coupon-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-tab.active {
  background: #111827;
  color: #fff;
}
