<view class="container sub-page">
  <view class="sub-hero">
    <view class="sub-label">优惠券核销 / 发放</view>
    <view class="sub-value">店长操作</view>
    <view class="sub-desc">先选主类型与折扣类型，再填变量。到店活动券，无需适用范围。</view>
  </view>

  <view class="list-card">
    <view class="field">
      <view class="field-label">会员手机号</view>
      <input class="field-input" type="number" maxlength="11" placeholder="与会员中心一致" value="{{phone}}" bindinput="onPhoneInput" />
      <view class="btn btn-secondary" bindtap="onSearch">查找</view>
    </view>

    <block wx:for="{{members}}" wx:key="_id">
      <view class="member-row {{selectedId === item._id ? 'active' : ''}}" data-id="{{item._id}}" bindtap="onPickMember">
        <view class="list-title">{{item.nickName || '未命名'}} · {{item.phone}}</view>
        <view class="list-meta">余额 ¥{{item.totalBalance}} · {{item.tier}}</view>
      </view>
    </block>

    <view class="field" wx:if="{{selectedLabel}}">
      <view class="field-label">当前选中</view>
      <view class="list-meta">{{selectedLabel}}</view>
    </view>
  </view>

  <block wx:if="{{selectedId}}">
    <view class="section-title" style="margin-top: 28rpx;">发放优惠券</view>
    <view class="list-card">
      <view class="field">
        <view class="field-label">主类型</view>
        <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="field-input">{{categoryOptions[categoryIndex].label}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">折扣类型</view>
        <picker mode="selector" range="{{benefitOptions}}" range-key="label" value="{{benefitIndex}}" bindchange="onBenefitChange">
          <view class="field-input">{{benefitOptions[benefitIndex].label}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">{{benefitValueLabel}}</view>
        <input class="field-input" type="digit" placeholder="{{benefitValuePlaceholder}}" value="{{issueBenefitValue}}" bindinput="onBenefitValueInput" />
      </view>
      <view class="field">
        <view class="field-label">有效期开始</view>
        <picker mode="date" value="{{issueValidFrom}}" bindchange="onValidFromChange">
          <view class="field-input">{{issueValidFrom}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">有效期结束</view>
        <picker mode="date" value="{{issueExpireAt}}" bindchange="onExpireAtChange">
          <view class="field-input">{{issueExpireAt}}</view>
        </picker>
      </view>
      <view class="field" wx:if="{{issuePreviewName}}">
        <view class="field-label">券名预览</view>
        <view class="list-meta">{{issuePreviewName}}</view>
      </view>
      <view class="btn btn-primary {{issuing ? 'disabled' : ''}}" bindtap="onIssue">确认发放</view>
    </view>

    <view class="section-title" style="margin-top: 28rpx;">未使用优惠券</view>

    <view class="list-card" wx:if="{{coupons.length}}">
      <block wx:for="{{coupons}}" wx:key="id">
        <view class="list-row {{item.available ? '' : 'coupon-dimmed'}}">
          <view class="list-main">
            <view class="list-title">{{item.name}}</view>
            <view class="list-meta">{{item.meta}}</view>
            <view class="list-meta" wx:if="{{item.validRange}}">有效期 {{item.validRange}}</view>
          </view>
          <view class="coupon-side">
            <view class="coupon-amount">{{item.benefitText}}</view>
            <view
              class="btn btn-secondary redeem-btn {{item.available ? '' : 'disabled'}}"
              data-id="{{item.id}}"
              data-available="{{item.available}}"
              data-name="{{item.name}}"
              data-benefit="{{item.benefitText}}"
              bindtap="onRedeem"
            >{{item.available ? '核销' : item.statusText}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="empty-tip" wx:elif="{{!loadingCoupons}}">该会员暂无未使用优惠券</view>
  </block>
</view>
