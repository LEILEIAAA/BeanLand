.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  box-sizing: border-box;
  height: calc(88rpx + env(safe-area-inset-bottom));
  padding: 6rpx 4rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: none;
  box-shadow: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 2rpx;
  padding-top: 2rpx;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.tab-text {
  font-size: 18rpx;
  line-height: 1.15;
  color: #a8a29e;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.tab-item.is-active .tab-text {
  color: #1c1917;
  font-weight: 700;
}
