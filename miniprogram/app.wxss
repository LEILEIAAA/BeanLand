page {
  min-height: 100vh;
  color: #18181b;
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px;
}

.container { padding: 28rpx; }

/* Reserve space under fixed custom-tab-bar (88rpx + safe area). */
.tab-page {
  box-sizing: border-box;
  padding-bottom: calc(108rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}
.hero-stage { position: relative; }
.hero-bands {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border-radius: 40rpx;
  overflow: hidden;
  filter: saturate(105%) blur(8px);
}
.band {
  height: 520rpx;
  opacity: 0.72;
  transform: scale(1.08);
  mix-blend-mode: screen;
}
.band-yellow { background: linear-gradient(180deg, rgba(250,204,21,0.72), rgba(250,204,21,0.24)); }
.band-orange { background: linear-gradient(180deg, rgba(249,115,22,0.70), rgba(249,115,22,0.24)); }
.band-pink { background: linear-gradient(180deg, rgba(236,72,153,0.70), rgba(236,72,153,0.24)); }
.band-blue { background: linear-gradient(180deg, rgba(14,165,233,0.70), rgba(14,165,233,0.24)); }
.band-green { background: linear-gradient(180deg, rgba(34,197,94,0.72), rgba(34,197,94,0.24)); }
.hero {
  position: relative;
  overflow: hidden;
  padding: 64rpx 36rpx 44rpx;
  border-radius: 40rpx;
  color: #1c1917;
  border: 1rpx solid rgba(28, 25, 23, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(28, 25, 23, 0.04);
  background: rgba(255, 255, 255, 0.88);
}
.hero-frost { backdrop-filter: blur(28px) saturate(180%); }
.hero-copy { position: relative; z-index: 2; }
.eyebrow { color: #78716c; font-size: 24rpx; font-weight: 600; letter-spacing: 1.5rpx; }
.title { margin-top: 14rpx; font-size: 52rpx; font-weight: 800; line-height: 1.12; letter-spacing: -1rpx; }
.subtitle { margin-top: 16rpx; color: #78716c; font-size: 28rpx; line-height: 1.72; max-width: 620rpx; }
.button-row { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 26rpx; }
.hero-actions .btn { flex: 1; }
.btn { display: flex; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; }
.btn-primary { color: #fff; background: #1c1917; box-shadow: 0 12rpx 28rpx rgba(28, 25, 23, 0.14); }
.btn-secondary { color: #1c1917; background: #fff; border: 1rpx solid rgba(28, 25, 23, 0.1); }
.section { margin-top: 56rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.section-title { font-size: 34rpx; font-weight: 800; letter-spacing: -0.5rpx; color: #18181b; }
.card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid rgba(28, 25, 23, 0.06); border-radius: 28rpx; background: #fff; box-shadow: 0 4rpx 20rpx rgba(28, 25, 23, 0.03); }
.glass-card { position: relative; overflow: hidden; }
.glass-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), transparent 55%); pointer-events: none; }
.card-title { font-size: 30rpx; font-weight: 800; }
.card-meta { margin-top: 10rpx; color: #78716c; font-size: 24rpx; line-height: 1.58; }
.price { color: #1c1917; font-size: 36rpx; font-weight: 800; }
.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.tag { padding: 8rpx 16rpx; border-radius: 999rpx; color: #57534e; background: #f5f5f4; font-size: 22rpx; font-weight: 600; }
.status-success { color: #166534; background: #dcfce7; }
.status-warning { color: #9a3412; background: #ffedd5; }
.loader-card { position: relative; }
.loader-line { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.loader { width: 44rpx; height: 44rpx; border-radius: 50%; border: 4rpx solid rgba(28, 25, 23, 0.08); border-top-color: #1c1917; animation: spin 0.9s linear infinite, pulse 1.8s ease-in-out infinite; }
.pulse { width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(28, 25, 23, 0.16); animation: bounce 1.2s ease-in-out infinite; }
.pulse-2 { animation-delay: 0.15s; }
.pulse-3 { animation-delay: 0.3s; }
.tappable { color: #1c1917; }
@keyframes spin { from { transform: rotate(0deg) scale(1); } to { transform: rotate(360deg) scale(1.06); } }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
@keyframes bounce { 0%, 100% { transform: translateY(0); opacity: .5; } 50% { transform: translateY(-8rpx); opacity: 1; } }
