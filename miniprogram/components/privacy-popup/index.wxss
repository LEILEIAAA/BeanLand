.pp-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(28, 25, 23, 0.45);
}

.pp-card {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 40rpx 32rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(28, 25, 23, 0.2);
}

.pp-title { font-size: 34rpx; font-weight: 800; color: #18181b; text-align: center; }
.pp-body { margin-top: 24rpx; color: #57534e; font-size: 27rpx; line-height: 1.78; }
.pp-link { color: #1c1917; font-weight: 700; text-decoration: underline; }

.pp-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.pp-btn {
  flex: 1;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
  line-height: 1.4;
}
.pp-btn::after { border: none; }
.pp-reject { color: #78716c; background: #f5f5f4; }
.pp-agree { color: #fff; background: #1c1917; }
