.pl {
  padding: 48rpx 8rpx 24rpx;
}

.pl-compact {
  padding: 32rpx 0 16rpx;
}

.pl-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.pl-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(28, 25, 23, 0.08);
  border-top-color: #1c1917;
  animation: pl-spin 0.85s linear infinite;
}

.pl-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pl-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(28, 25, 23, 0.18);
  animation: pl-bounce 1.15s ease-in-out infinite;
}

.pl-dot-2 {
  animation-delay: 0.12s;
}

.pl-dot-3 {
  animation-delay: 0.24s;
}

.pl-tip {
  color: #78716c;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pl-card {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(28, 25, 23, 0.05);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 28rpx rgba(28, 25, 23, 0.04);
  overflow: hidden;
}

.pl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
}

.pl-row + .pl-row {
  border-top: 1rpx solid rgba(28, 25, 23, 0.05);
}

.pl-col {
  flex: 1;
  min-width: 0;
}

.pl-bar {
  position: relative;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f5f5f4;
}

.pl-bar::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-120%);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.85),
    transparent
  );
  animation: pl-shimmer 1.35s ease-in-out infinite;
}

.pl-bar-title {
  height: 28rpx;
}

.pl-bar-title.is-wide {
  width: 72%;
}

.pl-bar-title.is-mid {
  width: 48%;
}

.pl-bar-meta {
  width: 42%;
  height: 20rpx;
  margin-top: 14rpx;
  opacity: 0.9;
}

.pl-chip {
  flex-shrink: 0;
  width: 96rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #f5f5f4;
  position: relative;
  overflow: hidden;
}

.pl-chip::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-120%);
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.85),
    transparent
  );
  animation: pl-shimmer 1.35s ease-in-out infinite;
  animation-delay: 0.15s;
}

@keyframes pl-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes pl-bounce {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.45;
  }
  50% {
    transform: translateY(-7rpx);
    opacity: 1;
  }
}

@keyframes pl-shimmer {
  0% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(120%);
  }
}
